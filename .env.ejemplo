# Copie este archivo como ".env" (sin el .ejemplo) y ajústelo.
# El archivo .env NUNCA se sube a git: contiene su llave privada.

# ---------------------------------------------------------------
# Modo sin IA
# ---------------------------------------------------------------
# En true, el programa NO usa inteligencia artificial y ningún dato
# de ningún cliente sale de este computador. Funciona completo:
# recibe archivos, arma el checklist y exporta.
#
# Este es el valor por defecto. Si borra el archivo .env, el programa
# se queda en este modo.
SIN_IA=true

# ---------------------------------------------------------------
# Llave de la IA
# ---------------------------------------------------------------
# Solo hace falta si pone SIN_IA=false.
# Se saca de console.anthropic.com
ANTHROPIC_API_KEY=

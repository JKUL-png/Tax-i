# Copie este archivo como ".env" (sin el .ejemplo) y ajústelo.
# El archivo .env NUNCA se sube a git: contiene su llave privada.
#
# También se puede dejar como está: los tres valores de abajo se cambian
# desde el programa, en la pantalla de Cuenta, sin abrir este archivo.

# ---------------------------------------------------------------
# Modo sin IA
# ---------------------------------------------------------------
# En true, el programa NO usa inteligencia artificial y ningún dato
# de ningún cliente sale de este computador. Funciona completo:
# recibe archivos, arma el checklist, llena el Formulario 210 y
# exporta. Lo único que no hay es Rentai, la asistente.
#
# Este es el valor por defecto. Si borra el archivo .env, el programa
# se queda en este modo.
SIN_IA=true

# ---------------------------------------------------------------
# Llave de la IA (Rentai)
# ---------------------------------------------------------------
# Solo hace falta si pone SIN_IA=false.
#
# Se saca GRATIS en https://console.groq.com  ->  API Keys.
# No piden tarjeta de crédito.
#
# Se eligió Groq porque su capa gratis no cobra y porque se compromete
# a no entrenar modelos con lo que uno le manda ni a guardarlo. Aquí se
# manejan documentos tributarios de terceros, así que eso importa más
# que cualquier otra cosa.
#
# Qué sale de este computador cuando la IA está encendida: el nombre del
# cliente, el texto de sus documentos, su checklist y la conversación.
# Los archivos NO se mandan: de un PDF se manda el texto que se extrajo
# aquí, nunca el archivo.
GROQ_API_KEY=

# ---------------------------------------------------------------
# Cuál modelo usar (opcional)
# ---------------------------------------------------------------
# Si no lo pone, se usa openai/gpt-oss-120b, que es gratis y fue el que
# mejor encontró las cifras en los documentos de prueba.
#
# Su cupo son 200.000 tokens al día (unas 40 preguntas). Si se le acaba,
# ponga IA_MODELO=qwen/qwen3.8-27b, que tiene 2 millones al día aunque
# busca peor.
# IA_MODELO=openai/gpt-oss-120b
